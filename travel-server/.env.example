# Server
PORT=3300
JWT_SECRET=your-secret-key-change-me

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/travel_ai?schema=public"

# Model provider: SILICONFLOW or DEEPSEEK
MODEL_PROVIDER=DEEPSEEK

# SiliconFlow config (optional)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODEL=
SIICONFLOW_API_KEY=
SIICONFLOW_BASE_URL=
SIICONFLOW_MODEL=

# DeepSeek config
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Tavily Search API (Agent 联网搜索工具，免费额度 1000次/月)
# 注册地址：https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key
