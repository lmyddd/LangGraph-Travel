  "description": "智能景点介绍服务端基于node.js + express + LangChain",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "tsx src/index.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "typecheck": "tsc --noEmit",
